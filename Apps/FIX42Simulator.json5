{
    Application: {
        Type: "FIX42",
        Log: {
            Level: "debug",
            // File: "FIX42Simulator.log",
        },
    },
    Session: {
        Acceptor: {
            Port: 7777,
        },
        BeginString: 'FIX.4.2',
        TargetCompID: 'PAXSIM-CLIENT',
        SenderCompID: 'PAXSIM-SERVER',
        HBInterval: 10,
    },
    Control: {
        Acceptor: {
            Port: 8888,
        },
        Order: {
            Reject:  {
                Enter: 
                [
                    {Selector: {}              , Qualifier: {Reason:  1}},
                    {Selector: {Quantity: 5101}, Qualifier: {Reason: 11}},
                ],
                Replace: 
                [
                    {Selector: {}              , Qualifier: {Reason:  1}},
                    {Selector: {Quantity: 5101}, Qualifier: {Reason: 11}},
                ],
                Cancel: 
                [
                    {Selector: {}              , Qualifier: {Reason:  1}},
                    {Selector: {Quantity: 5101}, Qualifier: {Reason: 11}},
                ],
            },
            Cancel: 
            [
                {"Selector": {}                , "Qualifier": {"Reason":  "Supervisory"}},
                {"Selector": {"Quantity": 5101}, "Qualifier": {"Reason": "UserRequested"}},
            ],
            Fill: 
            [
                {"Selector": {}                , "Qualifier": [ { Quantity:  100, Price:  1.23 } ], },
                {"Selector": {"Quantity": 5101}, "Qualifier": [ { Quantity:  100, Price:  1.23 }, { Quantity:  200, Price:  2.34 }, { Quantity: 300, Price: 3.45 }, ], },
            ],
        },
        Fill: {
            Cancel: 
            [
                {"Selector": {}                               , "Qualifier": {"Reason": "Supervisory"}},
                {"Selector": {"Quantity": 5101, "Price": 1.23}, "Qualifier": {"Reason": "UserRequested"}},
            ],
            Correct: 
            [
                {"Selector": {}                               , "Qualifier": {"Reason": "Supervisory", Quantity:  100, Price:  1.23 }},
                {"Selector": {"Quantity": 5101, "Price": 1.23}, "Qualifier": {"Reason": "UserRequested", Quantity:  100, Price:  1.23 }},
            ],
        },
    },
}
